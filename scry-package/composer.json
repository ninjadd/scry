{
    "name": "scry/scry",
    "description": "A modern, reactive local database manager and explorer GUI for Laravel applications.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "database",
        "manager",
        "explorer",
        "gui",
        "postgres",
        "mysql"
    ],
    "authors": [
        {
            "name": "Scry Contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Scry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scry\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Scry\\ScryServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
