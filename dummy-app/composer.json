{
    "name": "scry/dummy-app",
    "type": "project",
    "description": "Host dummy Laravel application for scry package development",
    "require": {
        "php": "^8.2",
        "dompdf/dompdf": "^3.0",
        "fakerphp/faker": "^1.24",
        "laravel/framework": "^10.0|^11.0",
        "scry/scry": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan vendor:publish --tag=scry-assets --force --quiet"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
