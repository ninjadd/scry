{
    "name": "scry/scry",
    "description": "A modern, reactive database manager and explorer GUI for Laravel 10, 11, 12, and 13+ applications.",
    "license": "MIT",
    "homepage": "https://github.com/ninjadd/scry",
    "keywords": [
        "laravel",
        "database",
        "manager",
        "explorer",
        "gui",
        "postgres",
        "mysql",
        "mariadb",
        "sqlite",
        "sqlsrv"
    ],
    "authors": [
        {
            "name": "Daniel Dickson",
            "email": "ninjadd@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ninjadd/scry/issues",
        "source": "https://github.com/ninjadd/scry"
    },
    "require": {
        "php": "^8.2 | ^8.3 | ^8.4",
        "illuminate/contracts": "^10.0 | ^11.0 | ^12.0 | ^13.0",
        "illuminate/database": "^10.0 | ^11.0 | ^12.0 | ^13.0",
        "illuminate/support": "^10.0 | ^11.0 | ^12.0 | ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 | ^9.0 | ^10.0",
        "phpunit/phpunit": "^10.0 | ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Scry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scry\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Scry\\ScryServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
