{
    "name": "scry/scry",
    "description": "A high-performance database manager, visual workbench, Monaco SQL console, and ERD visualizer for Laravel applications and standalone CLI environments.",
    "license": "MIT",
    "homepage": "https://github.com/ninjadd/scry",
    "keywords": [
        "laravel",
        "database",
        "workbench",
        "cli",
        "cli-tool",
        "database-gui",
        "database-studio",
        "mysql-workbench",
        "monaco-editor",
        "query-builder",
        "erd",
        "mermaid",
        "manager",
        "explorer",
        "gui",
        "postgres",
        "mysql",
        "mariadb",
        "sqlite",
        "sqlsrv"
    ],
    "authors": [
        {
            "name": "Daniel Dickson",
            "email": "ninjadd@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ninjadd/scry/issues",
        "source": "https://github.com/ninjadd/scry"
    },
    "require": {
        "php": "^8.2 | ^8.3 | ^8.4",
        "illuminate/contracts": "^10.0 | ^11.0 | ^12.0 | ^13.0",
        "illuminate/database": "^10.0 | ^11.0 | ^12.0 | ^13.0",
        "illuminate/http": "^10.0 | ^11.0 | ^12.0 | ^13.0",
        "illuminate/routing": "^10.0 | ^11.0 | ^12.0 | ^13.0",
        "illuminate/support": "^10.0 | ^11.0 | ^12.0 | ^13.0",
        "symfony/console": "^6.0 | ^7.0 | ^8.0",
        "symfony/process": "^6.0 | ^7.0 | ^8.0"
    },
    "bin": [
        "bin/scry"
    ],
    "require-dev": {
        "orchestra/testbench": "^8.0 | ^9.0 | ^10.0",
        "phpunit/phpunit": "^10.0 | ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Scry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scry\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Scry\\ScryServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
